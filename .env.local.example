# Másold le ezt a fájlt .env.local néven, és töltsd ki. Ugyanezeket add meg a Vercelen is
# (Project → Settings → Environment Variables), majd Redeploy.
# Ami üresen marad, az bemutató módban fut – az oldal akkor sem omlik össze.

# --- Supabase (belépés, a beállítás mentése, tudásbázis-fájlok) ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ide-jon-az-anon-public-kulcs
# service_role kulcs – TITKOS, csak a szerveren él (fizetés rögzítése). Soha ne tedd NEXT_PUBLIC_ elé!
SUPABASE_SERVICE_ROLE_KEY=

# --- MI a beállításban (Claude) – console.anthropic.com → API Keys ---
ANTHROPIC_API_KEY=
# Nem kötelező: más modell (alapértelmezés: claude-opus-5)
# ANTHROPIC_MODEL=
# Bemutató módban (Supabase nélkül) az MI csak ezzel fut, mert ott a szerver nem tudja ellenőrizni a belépést
# DEMO_AI_ENABLED=1

# --- Természetes hangminták (ElevenLabs) – kulcs nélkül a böngésző hangja szól ---
ELEVENLABS_API_KEY=
# Nem kötelező: saját hang-azonosítók a négy hanghoz
# ELEVENLABS_VOICE_LUCA=
# ELEVENLABS_VOICE_DORA=
# ELEVENLABS_VOICE_BENCE=
# ELEVENLABS_VOICE_MATE=

# --- Fizetés (Stripe) – dashboard.stripe.com → Developers → API keys ---
STRIPE_SECRET_KEY=
# A csomag ára: Product catalog → a termék ára → Price ID (price_...)
STRIPE_PRICE_ID=
# Webhook: Developers → Webhooks → végpont: https://velyric.com/api/billing/webhook
# Események: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Nem kötelező: Stripe Tax automatikus adószámítás
# STRIPE_AUTOMATIC_TAX=1
